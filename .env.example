# ─── Firebase ────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# ─── Media Service ────────────────────────────────────────────────────────────
# URL of the Dockerized media upload service
VITE_MEDIA_SERVICE_URL=http://localhost:4000

# ─── Media Docker Volume Path (host machine bind mount) ──────────────────────
MEDIA_STORAGE_PATH=./media-storage

# ─── Firebase Admin (server-side only, never expose to frontend!) ─────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json
# JSON-encoded service account for Vercel and other managed hosts. Never commit its value.
FIREBASE_SERVICE_ACCOUNT=

# Production API and media service CORS allowlist (comma-separated origins).
CORS_ALLOWED_ORIGINS=https://your-client-domain.example
# Shared secret for server-to-server point awards. Never expose this to the browser.
INTERNAL_API_KEY=

# ─── Blockchain ───────────────────────────────────────────────────────────────
# For dev: use http://127.0.0.1:8545 (local Hardhat node)
# For testnet: use Polygon Amoy RPC
BLOCKCHAIN_RPC_URL=https://rpc-amoy.polygon.technology/
BLOCKCHAIN_PRIVATE_KEY=your-wallet-private-key
BLOCKCHAIN_CONTRACT_ADDRESS=0x...deployed-contract-address...

# Optional: Polygonscan API key for contract verification
POLYGONSCAN_API_KEY=your-polygonscan-api-key

# Optional: Polygon Mainnet RPC
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_AMOY_RPC_URL=https://rpc-amoy.polygon.technology/
